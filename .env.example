# ==============================================================================
# T3 Code & OpenCode Docker Environment Configuration
# ==============================================================================

# --- Networking & Ports ---
# Port for SSH access (used by T3 Code Desktop: Settings -> Connections -> Add environment -> SSH)
SSH_PORT=2222

# Port for T3 Code Server (used for direct web pairing and LAN access)
T3_PORT=3773

# Port for OpenCode Web UI (web browser interface for OpenCode)
OPENCODE_PORT=4096

# Automatically start OpenCode Web on boot? (true/false)
# Default is false: OpenCode Web remains OFF until explicitly started via ./opencode-start.sh or set to true.
ENABLE_OPENCODE_WEB=false

# Host binding for internal services
T3CODE_HOST=0.0.0.0
OPENCODE_HOSTNAME=0.0.0.0

# --- Authentication & Credentials ---
# Password for the 'coder' user (used for SSH login)
CODER_PASSWORD=change_this_strong_ssh_password

# Password for OpenCode Web UI access in browser (leave blank to disable web auth)
OPENCODE_SERVER_PASSWORD=change_this_strong_web_password

# Optional: Paste your local laptop public SSH key here (e.g. from ~/.ssh/id_ed25519.pub)
# It will be automatically added to /home/coder/.ssh/authorized_keys
SSH_PUBLIC_KEY=

# --- Security & Privilege Control ---
# Grant sudo access to 'coder' user? (true/false)
# SECURITY RECOMMENDATION: Set to false to prevent coding agents from modifying system files or attempting privilege escalation.
ENABLE_SUDO=false

# --- Resource Limitations ---
# Maximum CPU cores available to the container
CPU_LIMIT=4.0

# Maximum RAM memory available to the container
MEMORY_LIMIT=8G

# Reserved memory guaranteed for the container
MEMORY_RESERVATION=2G

# Maximum number of concurrent processes/threads (mitigates fork bombs)
PIDS_LIMIT=500

# --- Storage Persistence (Host Directory or Named Volume) ---
# Host directory paths where all project files, git worktrees, T3 SQLite database,
# and OpenCode configurations persist across container upgrades and deployments.
WORKSPACE_PATH=./workspace
CODER_HOME_PATH=./data/coder_home
SSH_KEYS_PATH=./data/ssh_host_keys

# --- Git & GitHub Identity (Required by coding agents to commit/clone) ---
GIT_USER_NAME=iDevakk
GIT_USER_EMAIL=219866223+idevakk@users.noreply.github.com

# Optional: GitHub Personal Access Token (PAT) for automated 'gh' CLI authentication
GITHUB_TOKEN=

# --- LLM API Keys (Optional: can also be entered inside OpenCode Web UI) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

